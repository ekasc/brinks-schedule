# ── Required in production ──
# Secret used to sign session JWTs. Generate a strong random value, e.g.:
#   JWT_SECRET=$(openssl rand -hex 32)
# If this is unset, the app refuses to boot in production (and uses an insecure
# dev-only fallback in `npm run dev`).
JWT_SECRET=

# ── Recommended ──
# Absolute or relative path to the SQLite database file.
DB_PATH=./data/schedule.db
# Public origin of the app, used for absolute URLs and CSRF origin checks.
# Must match the host users actually visit (e.g. https://schedule.example.com).
ORIGIN=https://your-domain.example
# Timezone of the business. Booking times are parsed as server-local, so this
# must match the business location or appointment times will shift.
TZ=America/Vancouver
# Port the adapter-node server listens on.
PORT=3000
# Geocoder backend: photon (default), nominatim, or none.
GEOCODER=photon
# Directory where scripts/backup-db.mjs writes timestamped snapshots.
BACKUP_DIR=./backups
